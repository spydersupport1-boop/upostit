# ==============================================================================
# Attendance SaaS — Environment Configuration Template
# Copy this file to .env and configure your values. NEVER commit .env to git.
# ==============================================================================

# --- Application Environment ---
ENVIRONMENT=development
LOG_LEVEL=info
SECRET_KEY=change-this-insecure-default-key-minimum-32-characters-required
API_PORT=8000
API_HOST=0.0.0.0

# --- Supabase Project Credentials ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_ANON_KEY=placeholder_anon_key
SUPABASE_SERVICE_ROLE_KEY=placeholder_service_role_key

# --- Supabase PostgreSQL Connection ---
# Provide your Supabase PostgreSQL connection string (asyncpg driver required)
# Format: postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres:placeholder_password@db.placeholder-ref.supabase.co:5432/postgres
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_ECHO=false

# --- Redis Cache & Celery Queue ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Object Storage (MinIO locally / Supabase Storage in production) ---
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=placeholder_access_key
STORAGE_SECRET_KEY=placeholder_secret_key
STORAGE_BUCKET=attendance-assets
STORAGE_USE_SSL=false

# --- Authentication & JWT Security (Phase 2) ---
JWT_SECRET_KEY=change-this-jwt-secret-minimum-32-characters-required
JWT_ALGORITHM=HS256
JWT_ISSUER=attendance-saas
JWT_AUDIENCE=attendance-app
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000"]
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- Database Security & Roles (Phase 2) ---
# Migration connection string (uses privileged role for DDL)
MIGRATION_DATABASE_URL=postgresql+asyncpg://postgres:placeholder_password@db.placeholder-ref.supabase.co:5432/postgres
# Runtime application database role enforcing RLS (non-bypassrls)
RUNTIME_DATABASE_ROLE=authenticated

# --- Client Application URLs ---
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ==============================================================================
# Phase 10: Notifications & Push Integration (Placeholders Only)
# ==============================================================================
PUSH_TOKEN_ENCRYPTION_KEY=
FIREBASE_CREDENTIALS_PATH=
FIREBASE_CREDENTIALS_JSON=
FIREBASE_PROJECT_ID=
FCM_ENABLED=false
